# ==========================================
# 🚨 RAG 业务自定义与机密安全隔离 (必须添加)
# ==========================================

# 1. 提交通用配置模板，忽略本地私有配置
src/main/resources/application-local.yaml
src/main/resources/application-private.yaml
.env
.env.*

# 2. 忽略本地运行产生的文件上传存储目录
uploads/
# 3. 忽略 Spring Boot 运行日志
*.log

# 4. 操作系统产生的隐藏缓存文件 (尤其是 macOS)
.DS_Store

# 5. Ignore local Chroma vector database data
.chroma_data/
